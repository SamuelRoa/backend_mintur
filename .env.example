# ============================================================
# BASE DE DATOS — NEON POSTGRESQL
# ============================================================
# URL con pooler (para queries en runtime/producción)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# URL directa (para prisma db pull/push/migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ============================================================
# SERVIDOR
# ============================================================
PORT=8000
NODE_ENV=development

# ============================================================
# AUTENTICACIÓN JWT
# ============================================================
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_muy_seguro
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# CORREO — GMAIL
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=tu_app_password_de_gmail
MAIL_FROM="COTATUR <tucorreo@gmail.com>"

# ============================================================
# CORS — ORÍGENES PERMITIDOS
# ============================================================
CORS_ORIGINS=http://localhost:8001,http://localhost:8002
# En producción: CORS_ORIGINS=https://panel.vercel.app,https://website.vercel.app
# FRONTEND_URL=https://panel.vercel.app
# WEBSITE_URL=https://website.vercel.app
